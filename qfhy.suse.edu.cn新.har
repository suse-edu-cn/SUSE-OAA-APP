            "text": ".taskDetail{background-color:#fff;border-radius:8px;display:flex;flex-direction:column;min-height:100%;padding:16px}.taskDetail .taskInfo .taskTitle{align-items:center;display:flex;flex-wrap:wrap;justify-content:space-between;margin-bottom:18px}.taskDetail .taskInfo .taskTitle .ant-typography{margin:0}.taskDetail .taskInfo .taskTitleSmall{color:#999;font-size:14px;padding-left:6px}.taskDetail .taskInfo .qdrwsm{margin-bottom:18px}.taskDetail .taskInfo .signDetail{background-color:#f5f5f5;border-radius:6px;padding:8px}.taskDetail .taskInfo .signDetail h5{margin:4px 0}.taskDetail .taskInfo .signDetail .small{font-size:13px;padding-left:6px}.taskDetail .taskInfo .signDetail .signResult{color:#999;font-size:13px}.taskDetail .taskInfo .signDetail.active{border:1px solid #1890ff}.taskDetail .taskAction{align-items:center;display:flex;flex:1 1;justify-content:center;margin-top:18px}.taskDetail .tsskdetailForm{background:#f5f5f5;border-radius:6px;margin-top:18px}.taskDetail .tsskdetailForm .adm-card{background-color:#f5f5f5}.taskDetail .tsskdetailForm .adm-card img{max-height:120px;max-width:100px}li,ul{list-style:none;margin:0;padding:0}.ttllltt{font-size:16px;font-weight:600}.detailList .detailListItem{display:flex;justify-content:space-between;margin-bottom:12px}.detailList .detailListItem label{width:150px}.detailList .detailListItem .valuevvvv{flex:1 1}.locationaction .locationMap{height:100vh;left:0;position:fixed;top:0;width:100vw;z-index:9999999999}.locationaction .locationMap .mask{align-items:center;background:rgba(0,0,0,.2);display:flex;flex-direction:column;height:100%;justify-content:center;width:100%}.locationaction .locationMap .mask .mapcontffts{background:#fff;border-radius:6px}.locationaction .locationMap .mask .mapcontffts .usermapcontaim{height:50vh;padding:12px;width:86vw}.locationaction .locationMap .mask .mapcontffts .mapfooter{color:#1890ff;line-height:46px;text-align:center}.locationaction .hidden.locationMap{opacity:0;z-index:-1}.locationaction{align-items:center}.locationaction,.locationaction .actionBtn{display:flex;flex-direction:column;justify-content:center}.locationaction .actionBtn{background-color:#1890ff;border:none;border-radius:50%;color:#fff;height:150px;position:relative;text-align:center;width:150px}.locationaction .actionBtn .status{font-size:18px;width:100%}.locationaction .actionBtn .time{color:#ffffff96;font-size:16px}.locationaction .actionBtn.disabled{background-color:#d5d5d5}.locationaction .actionBtn.warning{background-color:#faad14}.locationaction .actionBtn.success{background-color:#52c41a}.locationaction .info{align-items:center;color:#888;display:flex;justify-content:center;line-height:22px;padding-top:16px;text-align:center}.locationaction .radar-scan{animation:rotate 2s linear infinite;background:conic-gradient(rgba(0,0,0,.2) 0,transparent 15%,transparent);border-radius:50%;height:150px;left:0;position:absolute;top:0;width:150px}@keyframes rotate{0%{transform:rotate(0deg)}to{transform:rotate(1turn)}}.codeContent{align-items:center;display:flex;flex-direction:column}.codeContent .qrcodett{height:190px;width:190px}.codeContent .info{color:#999;font-size:13px;padding-top:12px}.codeErrorinfo{align-items:center;background-color:#eee;border:1px solid #eee;border-radius:4px;color:#999;display:flex;font-size:13px;height:190px;justify-content:center;padding:26px;text-align:center;width:190px}.listArea{padding-top:20px}.renwuList{display:flex;flex-direction:row;flex-wrap:wrap;gap:16px;padding:0 24px}.renwuList .renwuItem{cursor:pointer;min-width:285px}.taskDetailDrawer .ant-drawer-body{background:#f5f5f5;padding:16px}@media (max-width:768px){.listArea{max-height:calc(100vh - 46px);overflow-y:auto}.sui-pro-layout-mobile.mobilehasbottomnav .listArea{max-height:calc(100vh - 114px)}.renwuList{flex-direction:column;padding:16px}}"
