            "text": ".roles{min-height:100vh;width:100%}.roles .content{padding-top:120px}.roles .content .wrap{margin:0 auto;max-width:500px;width:90%}.roles .content .wrap .userInfo{align-content:center;align-items:center;display:flex;flex-direction:row;flex-wrap:nowrap;justify-content:flex-start}.roles .content .wrap .userInfo .avatar{padding:35px 10px;text-align:center}.roles .content .wrap .userInfo .userName{color:#fff}.roles .content .wrap .userInfo .userName div:first-child{font-size:16px;font-weight:700;padding-bottom:10px}.roles .content .wrap .groups{padding:10px;text-align:center}.roles .content .wrap .groups .listItem{align-content:stretch;align-items:center;background:#fff;border-radius:10px;color:#222;cursor:pointer;display:flex;flex-direction:row;flex-wrap:nowrap;font-size:18px;font-weight:700;justify-content:space-between;margin-top:20px;padding:25px}.roles .content .wrap .chooseTitle{color:#fff;font-size:26px;font-weight:700;letter-spacing:5px;padding-left:12px}.roles .content .wrap .btns{align-content:center;display:flex;flex-direction:row;flex-wrap:wrap;justify-content:center;padding:30px 10px 10px}.roles .content .wrap .btns .listItem{background:#fff;border-radius:20px;cursor:pointer;display:inline-block;height:180px;line-height:20px;margin:20px 10px 0;padding:20px;text-align:center;width:190px}.roles .content .wrap .btns .listItem .img{height:100px;margin:0 auto;width:80px}.roles .content .wrap .btns .listItem .img img{border-radius:20px;height:100%;width:100%}.roles .content .wrap .btns .listItem .user{color:#222;font-weight:700;height:60px;overflow:hidden;width:100%}.roles .content .wrap .btns .listItem:hover{box-shadow:0 1px 2px -2px rgba(0,0,0,.16),0 3px 6px 0 rgba(0,0,0,.12),0 5px 12px 4px rgba(0,0,0,.09);transform:scale(1.1)}@media (max-width:700px){.roles .content{padding-top:60px}}"
